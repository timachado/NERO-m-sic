        <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME" android:value="br.com.timachado.neromusic.NeroCastOptions" />
        <activity android:name=".NeroCastActivity" android:exported="false" android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <service android:name=".PlaybackService" android:exported="true" tools:replace="android:exported">
