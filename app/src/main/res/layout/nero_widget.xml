<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/nero_widget_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_nero" android:contentDescription="@string/app_name" android:scaleType="fitCenter"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NERO MUSIC" android:textColor="#00E5FF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sua música" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Abra o NERO" android:textColor="#B9C6CF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_previous" android:tint="#FFFFFF" android:contentDescription="Faixa anterior"/>
        <ImageButton android:id="@+id/widget_toggle" android:layout_width="64dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play" android:tint="#39FF14" android:contentDescription="Reproduzir"/>
        <ImageButton android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_next" android:tint="#FFFFFF" android:contentDescription="Próxima faixa"/>
    </LinearLayout>
</LinearLayout>